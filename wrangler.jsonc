/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "whitedevil-ai",
	"main": "src/index.ts",
	"secrets": { "required": ["MEMORY_OWNER_EMAIL"] },
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"previews": {
		// Reuse this preview's owner secret without putting its value in Git.
		"unsafe": {
			"bindings": [{ "name": "MEMORY_OWNER_EMAIL", "type": "inherit" }]
		},
		"vars": {
			"ACCESS_TEAM_DOMAIN": "https://withered-pine-4dda.cloudflareaccess.com",
			"ACCESS_AUD": "d0e1dba394c9fce4295e528b1c259e5cb018803f14ad5dd169c2420332700cb9"
		},
		"d1_databases": [{
			"binding": "DB",
			"database_name": "whitedevil-memory-preview-v51",
			"database_id": "9df8c4a9-05a6-4bf4-b572-d31ec25d3f8e",
			"migrations_dir": "migrations"
		}],
		"ai": {
			"binding": "AI"
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "whitedevil-memory-v51",
			"database_id": "189e5893-6f3d-4709-860a-9cae3d63c0b8",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"ACCESS_TEAM_DOMAIN": "https://withered-pine-4dda.cloudflareaccess.com",
		"ACCESS_AUD": "d0e1dba394c9fce4295e528b1c259e5cb018803f14ad5dd169c2420332700cb9"
	},
	"upload_source_maps": true
}

